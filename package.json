{
  "name": "rival",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract-tokens": "tsx scripts/extract-tokens.ts",
    "dev": "npm run extract-tokens && VITE_ENV=development vite",
    "prod": "npm run extract-tokens && VITE_ENV=production vite",
    "build": "npm run extract-tokens && npm run typecheck && VITE_ENV=production vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:styles:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run format:check"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.27.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@csstools/postcss-global-data": "^4.0.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.71.0",
    "postcss-custom-media": "^12.0.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}

