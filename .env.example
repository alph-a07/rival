# ─────────────────────────────────────────────────────────────────────────────
#  Environment configuration template
# ─────────────────────────────────────────────────────────────────────────────
#  Mode config: copy `VITE_ENV` into the matching committed file
#      `.env.development`   →  VITE_ENV=development
#      `.env.production`    →  VITE_ENV=production
#  Secrets:      put in `.env.local` (git-ignored, every mode) or
#                `.env.development.local` / `.env.production.local`.
#  Vite load order (later wins): `.env` → `.env.local` → `.env.[mode]` → `.env.[mode].local`.
# ─────────────────────────────────────────────────────────────────────────────

# Provisioning environment — drives log verbosity in src/core/logging/config.ts.
VITE_ENV=development

# Firebase (Google Identity Platform) — from
# Firebase console → Project settings → Your apps → Web → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — hosted token-refresh endpoint for seamless Drive access.
# Deployed URL of the `refreshDriveToken` Cloud Function (see `functions/`).
# When set, an expired Drive token is refreshed without re-prompting the user.
# Leave empty to fall back to a re-auth popup (dev).
VITE_DRIVE_TOKEN_FUNCTION=
