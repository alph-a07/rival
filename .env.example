# ─────────────────────────────────────────────────────────────────────────────
#  Environment configuration template
# ─────────────────────────────────────────────────────────────────────────────
#  Mode config: copy `VITE_ENV` into the matching committed file
#      `.env.development`   →  VITE_ENV=development
#      `.env.production`    →  VITE_ENV=production
#  Secrets:      put in `.env.local` (git-ignored, every mode) or
#                `.env.development.local` / `.env.production.local`.
#  Vite load order (later wins): `.env` → `.env.local` → `.env.[mode]` → `.env.[mode].local`.
# ─────────────────────────────────────────────────────────────────────────────

# Provisioning environment — drives log verbosity in src/core/logging/config.ts.
VITE_ENV=development

# Google Identity Services (GSI) — from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web app).
# Used for the Google Drive sign-in/code flow (no Firebase).
VITE_GOOGLE_CLIENT_ID=

# Origins the app accepts Google sign-in from (comma-separated, exact scheme + host + port).
# Must match the Origins registered for the OAuth client in Google Cloud Console.
# Defaults to http://localhost:5173 when unset.
VITE_AUTHORIZED_ORIGINS=

# Base URL of the Cloudflare Worker handling server-side Drive token refresh
VITE_DRIVE_TOKEN_FUNCTION=
